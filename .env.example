# Copy this file to .env and adjust for your environment.

# Public URL of the site
VITE_SITE_URL=https://pinnacleone.co.in

# Sub-path the app is served from. Use "/" for the domain root.
VITE_BASE_PATH=/

# --- Used by deploy.sh only (not exposed to the browser) ---
# Git branch to pull on the server
DEPLOY_BRANCH=main

# Folder the web server (nginx/apache) serves the built files from
DEPLOY_DIR=/var/www/pinnacleone.co.in
